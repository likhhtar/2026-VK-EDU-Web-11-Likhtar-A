# Скопируйте в файл .env в корне проекта: cp .env.example .env
# (python-decouple читает именно .env). Варианты .env.local и .env.docker —
# это копии с разными значениями; при необходимости подключайте их вручную.

SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,testserver

# PostgreSQL. Для быстрой разработки без сервера БД: DB_ENGINE=sqlite
DB_NAME=eduweb
DB_USER=eduweb
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_ENGINE=

# Для debug-toolbar в docker при необходимости:
# USE_DOCKER_INTERNAL_IPS=True

# Необязательно: множитель лайков в fill_db (по умолчанию 200 → ratio*200)
# FILLDB_LIKES_PER_RATIO=200
